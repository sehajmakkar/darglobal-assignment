# Keep the build context small and secret-free.
.git
.github
.env
.env.*
!.env.example
.venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache
.mypy_cache
.DS_Store

# Private docs + scratch (never in the image either)
CLAUDE.md
plan.md
decisions.md
challenges.md
notes/
.claude/

# Raw scraped data, caches, local indexes
data/raw/
data/cache/
data/index/

# Not needed at runtime
tests/
# Offline-only scraper code never ships (D-003); its deps are excluded via --no-default-groups
src/dgbot/scraping/
frontend/node_modules/
