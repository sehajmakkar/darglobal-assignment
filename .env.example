# Copy to .env and fill in. Never commit .env.

# ── OpenRouter ───────────────────────────────────────────────
# One key ...
OPENROUTER_API_KEY=sk-or-v1-...
# ... or a comma-separated pool (failover on HTTP 429). Keys from one account share a quota.
# OPENROUTER_API_KEYS=sk-or-v1-...,sk-or-v1-...

# Primary model first, then fallbacks. All must be free (":free") models.
# DGBOT_LLM_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,openrouter/free
# DGBOT_LLM_TIMEOUT_S=60

# ── Runtime ──────────────────────────────────────────────────
# DGBOT_ENV=dev            # dev | test | prod (prod = JSON logs)
# DGBOT_LOG_LEVEL=INFO
# PORT=7860                # Hugging Face Spaces expects 7860

# ── Scraping (offline only) ──────────────────────────────────
# DGBOT_SCRAPER_MAX_RPS=1.0   # capped at 2.0 by design
